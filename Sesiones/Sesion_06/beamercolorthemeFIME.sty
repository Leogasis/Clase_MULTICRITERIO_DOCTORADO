\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeFIME}[2026/05/22 v1.0.0 FIME Beamer Color Theme]
\RequirePackage{xcolor}

\definecolor{FIMEgreen}{HTML}{005C42}
\definecolor{UANLblue}{HTML}{002F6C}
\definecolor{UANLgold}{HTML}{FFC72C}
\definecolor{FIMEblack}{HTML}{0F172A}
\definecolor{FIMEwhite}{HTML}{FFFFFF}
\definecolor{FIMElightgray}{HTML}{F8FAFC}
\definecolor{FIMEmidgray}{HTML}{E2E8F0}
\definecolor{FIMEdarkgray}{HTML}{475569}
\definecolor{RedAccent}{HTML}{DC2626}
\definecolor{GreenAccent}{HTML}{16A34A}

\setbeamercolor{structure}{fg=FIMEgreen}
\setbeamercolor{title}{fg=FIMEblack}
\setbeamercolor{subtitle}{fg=FIMEdarkgray}
\setbeamercolor{author}{fg=UANLblue}
\setbeamercolor{institute}{fg=FIMEdarkgray}
\setbeamercolor{date}{fg=FIMEdarkgray}
\setbeamercolor{frametitle}{fg=FIMEblack,bg=FIMEwhite}
\setbeamercolor{framesubtitle}{fg=FIMEdarkgray}
\setbeamercolor{normal text}{fg=FIMEblack,bg=FIMEwhite}
\setbeamercolor{alerted text}{fg=RedAccent}
\setbeamercolor{example text}{fg=GreenAccent}

\setbeamercolor{block title}{fg=FIMEwhite,bg=UANLblue}
\setbeamercolor{block body}{fg=FIMEblack,bg=FIMElightgray}
\setbeamercolor{block title alerted}{fg=FIMEwhite,bg=RedAccent}
\setbeamercolor{block body alerted}{fg=FIMEblack,bg=FIMElightgray}
\setbeamercolor{block title example}{fg=FIMEwhite,bg=FIMEgreen}
\setbeamercolor{block body example}{fg=FIMEblack,bg=FIMElightgray}

\setbeamercolor{item}{fg=UANLgold}
\setbeamercolor{subitem}{fg=FIMEgreen}
\setbeamercolor{subsubitem}{fg=FIMEdarkgray}
\setbeamercolor{item projected}{fg=FIMEwhite,bg=FIMEgreen}

\setbeamercolor{footline}{fg=FIMEdarkgray,bg=FIMEwhite}
\setbeamercolor{headline}{fg=UANLblue,bg=FIMEwhite}

\setbeamercolor{section in toc}{fg=UANLblue}
\setbeamercolor{subsection in toc}{fg=FIMEdarkgray}
\setbeamercolor{section number projected}{fg=FIMEwhite,bg=FIMEgreen}

\setbeamercolor{caption name}{fg=UANLblue}
\setbeamercolor{caption}{fg=FIMEdarkgray}

\endinput
